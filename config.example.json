{
  "collector": {
    "intervalSeconds": 5,
    "catalogRefreshSeconds": 30,
    "powershellExecutable": "powershell.exe"
  },
  "storage": {
    "directory": ".\\data",
    "maxLogFileMb": 100,
    "retentionDays": 14,
    "preIncidentMinutes": 5,
    "postIncidentMinutes": 2,
    "incidentCooldownMinutes": 10
  },
  "thresholds": {
    "consecutiveSamples": 6,
    "systemCpuPercent": 90,
    "availableMemoryPercent": 10,
    "sampleDelaySeconds": 15,
    "healthConsecutiveFailures": 3
  },
  "targets": [
    {
      "id": "aplicacao-node",
      "label": "Aplicacao Node",
      "serviceNames": [],
      "processNames": ["node.exe"],
      "executablePathIncludes": [],
      "commandLineIncludes": ["SUBSTITUIR-PELO-NOME-DO-ARQUIVO-DA-APLICACAO.js"],
      "maxCpuPercent": null,
      "maxPrivateMemoryMb": null,
      "healthChecks": [
        {
          "url": "http://127.0.0.1:3000/health",
          "timeoutMs": 3000,
          "intervalSeconds": 15
        }
      ]
    },
    {
      "id": "tomcat",
      "label": "Tomcat",
      "serviceNames": [],
      "processNames": ["java.exe"],
      "executablePathIncludes": [],
      "commandLineIncludes": ["catalina.base=SUBSTITUIR-PELO-DIRETORIO-DO-TOMCAT"],
      "maxCpuPercent": null,
      "maxPrivateMemoryMb": null,
      "healthChecks": [
        {
          "url": "http://127.0.0.1:8080/",
          "timeoutMs": 5000,
          "intervalSeconds": 15
        }
      ]
    }
  ],
  "perfmon": {
    "collectorName": null,
    "startWithMonitor": false,
    "stopWithMonitor": false
  }
}
